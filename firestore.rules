rules_version = '2';

// kuwaGO — Cloud Firestore security rules (project rooted-f95c7).
//
// Each signed-in user (Google, email or guest) can read and write ONLY their
// own data: users/{uid} and everything under it (e.g. users/{uid}/sessions).
// Nobody can read or write anyone else's garden, notes or study material.
//
// Deploy after changing (needs the Firebase CLI, logged in as the project owner):
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
